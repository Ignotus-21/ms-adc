<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="cloud-run-backend">
    <Description>Google Cloud Run Private Backend (ms-adc-api)</Description>
    <FaultRules/>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>Mint-Google-OIDC-Token</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <HTTPTargetConnection>
        <Authentication>
            <GoogleIDToken>
                <Audience>https://ms-adc-api-be4mdtaema-uc.a.run.app</Audience>
            </GoogleIDToken>
        </Authentication>
        <Properties>
            <Property name="io.timeout.millis">60000</Property>
            <Property name="connect.timeout.millis">10000</Property>
        </Properties>
        <SSLInfo>
            <Enabled>true</Enabled>
        </SSLInfo>
        <URL>https://ms-adc-api-be4mdtaema-uc.a.run.app</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
